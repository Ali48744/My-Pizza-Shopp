<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Pizza & Fast Food Shop</title>

<style>
body {
    font-family: Arial, sans-serif;
    margin: 0;
    background:#f4f4f4;
    direction: ltr;
}
header {
    background:#ff4500;
    color:white;
    text-align:center;
    padding:20px;
}
nav {
    background:#333;
    padding:10px;
    text-align:center;
}
nav a {
    color:white;
    margin:0 10px;
    text-decoration:none;
}
section {
    background:white;
    margin:20px;
    padding:20px;
    border-radius:8px;
}
.menu-item {
    display:flex;
    margin-bottom:15px;
}
.menu-item img {
    width:120px;
    height:80px;
    margin-right:15px;
}
button, input, select {
    padding:10px;
    width:100%;
    margin:8px 0;
}
.order-btn {
    background:#25D366;
    color:white;
    border:none;
    font-size:18px;
    cursor:pointer;
}
.call-btn {
    background:#ff4500;
    color:white;
    text-decoration:none;
    padding:10px;
    display:inline-block;
    margin-top:10px;
}
footer {
    background:#333;
    color:white;
    text-align:center;
    padding:15px;
}
</style>
</head>

<body>

<header>
<h1>🍕 My Pizza & Fast Food Shop</h1>
<p>Owner: <strong>Muneeb-UR-Rehman</strong></p>
<p>📞 <a href="tel:03244991725" style="color:white;">0324-4991725</a></p>

<a class="call-btn" href="tel:03244991725">📞 Call to Order</a>
</header>

<nav>
<a href="#menu">Menu</a>
<a href="#order">Order Now</a>
<a href="#contact">Contact</a>
</nav>

<section id="menu">
<h2>📋 Our Menu</h2>

<!-- Pizza Menu -->
<div class="menu-item">
<img src="https://images.pexels.com/photos/315755/pexels-photo-315755.jpeg?auto=compress&cs=tinysrgb&w=150&h=100" alt="Margherita Pizza">
<div>
<h3>Margherita Pizza</h3>
<p>Price: 1800 PKR</p>
</div>
</div>

<div class="menu-item">
<img src="https://images.pexels.com/photos/70497/pexels-photo-70497.jpeg?auto=compress&cs=tinysrgb&w=150&h=100" alt="Pepperoni Pizza">
<div>
<h3>Pepperoni Pizza</h3>
<p>Price: 2200 PKR</p>
</div>
</div>

<div class="menu-item">
<img src="https://images.pexels.com/photos/315755/pexels-photo-315755.jpeg?auto=compress&cs=tinysrgb&w=150&h=100" alt="Veggie Pizza">
<div>
<h3>Veggie Pizza</h3>
<p>Price: 2000 PKR</p>
</div>
</div>

<!-- Fast Food Menu -->
<div class="menu-item">
<img src="https://images.pexels.com/photos/1639567/pexels-photo-1639567.jpeg?auto=compress&cs=tinysrgb&w=150&h=100" alt="Burger">
<div>
<h3>Burger</h3>
<p>Price: 800 PKR</p>
</div>
</div>

<div class="menu-item">
<img src="https://images.pexels.com/photos/1580464/pexels-photo-1580464.jpeg?auto=compress&cs=tinysrgb&w=150&h=100" alt="French Fries">
<div>
<h3>French Fries</h3>
<p>Price: 400 PKR</p>
</div>
</div>

<div class="menu-item">
<img src="https://images.pexels.com/photos/1639566/pexels-photo-1639566.jpeg?auto=compress&cs=tinysrgb&w=150&h=100" alt="Sandwich">
<div>
<h3>Sandwich</h3>
<p>Price: 600 PKR</p>
</div>
</div>

</section>

<section id="order">
<h2>📝 Order Form</h2>

<form onsubmit="sendWhatsApp(); return false;">
<input type="text" id="name" placeholder="Your Name" required>
<input type="text" id="address" placeholder="Full Address" required>

<select id="pizza">
<option>Margherita Pizza</option>
<option>Pepperoni Pizza</option>
<option>Veggie Pizza</option>
<option>Burger</option>
<option>French Fries</option>
<option>Sandwich</option>
</select>

<input type="number" id="qty" placeholder="Quantity" required>

<button class="order-btn" type="submit">
🟢 Order on WhatsApp
</button>
</form>
</section>

<section id="contact">
<h2>📞 Contact Us</h2>
<p>Phone: 0324-4991725</p>
<p>WhatsApp: 0324-4991725</p>
<p>Hours: 11:00 AM – 10:00 PM</p>
</section>

<footer>
<p>© 2026 My Pizza & Fast Food Shop</p>
<p>Owner: Muneeb-UR-Rehman</p>
</footer>

<script>
function sendWhatsApp() {
    var name = document.getElementById("name").value;
    var address = document.getElementById("address").value;
    var pizza = document.getElementById("pizza").value;
    var qty = document.getElementById("qty").value;

    var message = 
        "🍕 Food Order\n\n" +
        "Name: " + name + "\n" +
        "Item: " + pizza + "\n" +
        "Quantity: " + qty + "\n" +
        "Address: " + address;

    var url = "https://wa.me/923244991725?text=" + encodeURIComponent(message);
    window.open(url, "_blank");
}
</script>

</body>
</html>
